config fubotv 'main'
	# 是否启用周期上报
	option enabled '0'

	# 天气时钟的 IP 地址或主机名
	option host '192.168.88.244'

	# HTTP 端口，留空或 80 时不写入 URL
	option port '80'

	# 上报间隔（秒），范围 1-3600
	option interval '1'

	# VOL 指标统计的 LAN 接口
	option interface 'br-lan'

	# 接口速率回退值（Mbps）。仅在无法从 sysfs 自动探测时生效
	option linkspeed '1000'

	# 上报路径
	option path '/PCM'

	# 认证串，作为 POST 表单主体的首个字段发送，留空则不附加。
	# 原版上位机固定为 admin=root；凭据错误时设备会直接断开连接。
	option auth 'admin=root'

	# 三项指标对应的表单参数名
	option param_cpu 'T1'
	option param_ram 'T2'
	option param_vol 'T3'
