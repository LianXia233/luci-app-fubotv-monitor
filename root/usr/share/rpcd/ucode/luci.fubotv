'use strict';
/*
 * fubotv-monitor -- rpcd ucode 后端
 *
 * ubus 对象: luci.fubotv
 *   status()  读取守护进程写入的最新指标与上报统计
 *   test()    立即采样一次并向时钟 POST 一条上报，用于验证连通性
 *
 * 此文件由 rpcd 通过 compile() + call() 加载（不是 import），
 * 所以顶层导出仍用 return { ... } 模式。
 * 内部 import lib.uc 时使用 export { ... } 语法（25.x import 强制要求）。
 *
 * 适配 OpenWrt 25.x / ImmortalWrt SNAPSHOT 的 ucode 2026.07+ API：
 *   - fs 模块用 namespace 导入；json() 是全局解码器
 *   - named import 严格要求所有名字都在模块的 export 列表中
 */

import * as fs from 'fs';
import * as uci from 'uci';
import * as ubus from 'ubus';
import { cpu_usage, mem_usage, vol_usage, iface_speed_mbps, shquote } from '/usr/share/fubotv/lib.uc';

const STATUS_FILE = '/var/run/fubotv.status';
const HTTP_TIMEOUT = 3000;

/* ------------------------------------------------------------------ 工具 */

function uci_conf() {
	let u = uci.cursor();

	u.load('fubotv');

	let get = function(key, def) {
		let v = u.get('fubotv', 'main', key);

		return (v != null && v != '') ? v : def;
	};

	return {
		enabled: get('enabled', '0') == '1',
		host: get('host', ''),
		port: get('port', ''),
		interval: int(get('interval', '1')) || 1,
		iface: get('interface', 'br-lan'),
		linkspeed: int(get('linkspeed', '1000')) || 1000,
		path: get('path', '/PCM'),
		auth: get('auth', 'admin=root'),
		p_cpu: get('param_cpu', 'T1'),
		p_ram: get('param_ram', 'T2'),
		p_vol: get('param_vol', 'T3')
	};
}

function build_url(c) {
	let host = c.host;

	if (index(host, ':') >= 0 && substr(host, 0, 1) != '[')
		host = '[' + host + ']';

	let url = 'http://' + host;

	if (c.port != '' && c.port != '80')
		url += ':' + c.port;

	let path = c.path;

	if (path != '' && substr(path, 0, 1) != '/')
		path = '/' + path;

	return url + ((path != '') ? path : '/PCM');
}

function build_body(c, cpu, ram, vol) {
	let out = '';

	if (c.auth != '')
		out = c.auth;

	out += (out != '' ? '&' : '') + c.p_cpu + '=' + int(cpu + 0.5);
	out += '&' + c.p_ram + '=' + int(ram + 0.5);
	out += '&' + c.p_vol + '=' + int(vol + 0.5);

	return out;
}

function service_running() {
	let s = ubus.call('service', 'list', { name: 'fubotv' });

	if (!s || !s.fubotv || !s.fubotv.instances)
		return false;

	for (let k in keys(s.fubotv.instances)) {
		if (s.fubotv.instances[k].running)
			return true;
	}

	return false;
}

/* ------------------------------------------------------------------ 方法 */

return {
	'luci.fubotv': {
		status: {
			args: { },
		call: function(args) {
			let c = uci_conf();
			let raw = fs.readfile(STATUS_FILE);
			let st = null;

			if (raw != null && raw != '') {
				try {
					/* ucode 25.x 全局 json() 是解码器（与旧版 import * as json 不同） */
					st = json(raw);
				}
				catch (e) {
					st = null;
				}
			}

			let running = service_running();
			let speed = iface_speed_mbps(c.iface);

			return {
				running: running,
				configured: c.host != '',
				enabled: c.enabled,
				host: c.host,
				interval: c.interval,
				iface: c.iface,
				linkspeed: (speed != null) ? speed : c.linkspeed,
				linkspeed_auto: (speed != null),
				path: c.path,
				cpu: (st != null) ? st.cpu : null,
				ram: (st != null) ? st.ram : mem_usage(),
				vol: (st != null) ? st.vol : null,
				rx_bps: (st != null) ? st.rx_bps : null,
				tx_bps: (st != null) ? st.tx_bps : null,
				count: (st != null) ? st.count : 0,
				ok: (st != null) ? st.ok : 0,
				fail: (st != null) ? st.fail : 0,
				last: (st != null) ? st.last : 0,
				last_ok: (st != null) ? st.last_ok : 0,
				error: (st != null) ? st.error : '',
				url: (st != null) ? st.url : '',
				body: (st != null) ? st.body : ''
			};
		}
	},

	test: {
		args: { },
		call: function(args) {
			let c = uci_conf();

			if (c.host == '')
				return { ok: false, code: 0, url: '', body: '', error: '尚未配置时钟 IP 地址' };

			/* CPU 与 VOL 是差值型指标，此处做一次 1 秒窗口采样 */
			cpu_usage();
			vol_usage(c.iface, c.linkspeed);
			sleep(1);

			let cpu = cpu_usage();
			let ram = mem_usage();
			let vol = vol_usage(c.iface, c.linkspeed);
			let url = build_url(c);
			let body = build_body(c, cpu, ram, vol);
			let tmp = '/tmp/.fubotv_test_' + time();

			/*
			 * 协议（实机验证）：
			 *   POST 表单主体，成功正文为令牌 0637；
			 *   凭据被拒时设备直接断连（curl 退出码 52/56，HTTP 码为 0）。
			 * 不经 -f，以拿到真实 HTTP 状态码与响应正文。
			 */
			system('curl -s -o ' + tmp + ' -w "%{http_code}" -m ' +
				int(HTTP_TIMEOUT / 1000) +
				' -H ' + shquote('Content-Type: application/x-www-form-urlencoded') +
				' --data ' + shquote(body) +
				' ' + shquote(url) + ' > ' + tmp + '.code 2>/dev/null', 8000);

			let code = int(trim(fs.readfile(tmp + '.code') || '0')) || 0;
			let resp = trim(fs.readfile(tmp) || '');

			fs.unlink(tmp);
			fs.unlink(tmp + '.code');

			/*
			 * 成功判据：HTTP 200 且正文含回执令牌 0637。
			 * 设备断连时 curl 写不出状态码，code 为 0。
			 */
			let ok = (code == 200 && index(resp, '0637') >= 0);

			let error = '';

			if (!ok) {
				if (code == 0)
					error = '设备无响应（凭据被拒或连接失败）';
				else if (code == 404)
					error = 'HTTP 404：路径或请求方法不对（设备仅接受 POST ' + c.path + '）';
				else if (code >= 200 && code < 400)
					error = 'HTTP ' + code + '：响应缺少回执令牌 0637';
				else
					error = 'HTTP ' + code;
			}

			return {
				ok: ok,
				code: code,
				url: url,
				body: body,
				resp: resp,
				cpu: cpu,
				ram: ram,
				vol: vol,
				error: error
			};
		}
	}
	}
};
